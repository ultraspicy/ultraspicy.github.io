---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  minCount?: number;
}

const { headings, minCount = 4 } = Astro.props;

// h2 + h3 only: h1 is the title, h4 is too granular for a scannable outline.
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const show = items.length >= minCount;
---

{
  show && (
    <nav class="toc" aria-label="Table of contents">
      <ul>
        {items.map((h) => (
          <li class={`toc-d${h.depth}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    margin: 1.5rem 0 2.5rem;
    padding-left: 1rem;
    border-left: 1px solid var(--border);
    font-size: 0.95rem;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc li {
    margin: 0.2rem 0;
  }

  .toc-d3 {
    padding-left: 1.1rem;
  }

  .toc a {
    color: var(--muted);
  }

  .toc a:hover {
    color: var(--link);
  }
</style>
